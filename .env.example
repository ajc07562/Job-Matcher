# Optional — without this, the app still runs and ranks matches, it just
# uses the fallback chain below for "why this fits" explanation text.
ANTHROPIC_API_KEY=

# How to generate match explanations: "anthropic", "ollama", or "auto" (default).
# "auto" uses Claude if ANTHROPIC_API_KEY is set above, otherwise tries a local
# Ollama server, otherwise shows a placeholder. To run explanations for $0:
# install Ollama (https://ollama.com), run `ollama pull llama3.2`, leave
# ANTHROPIC_API_KEY blank, and leave this on "auto" or set it to "ollama".
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Auto-refresh: periodically re-fetch real job listings in the background so the
# corpus doesn't go stale (off by default — makes outbound network calls on a timer).
AUTO_REFRESH_JOBS=false
REFRESH_INTERVAL_HOURS=24

# Where the FastAPI backend listens
API_HOST=127.0.0.1
API_PORT=8000
